# Server configuration
PORT=5000
NODE_ENV=development

# Allowed client origins for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000

# Supabase Cloud Database Configuration
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Optional: Service Role Key for elevated backend privileges
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MongoDB Atlas connection string (optional alternative)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/glow-and-go?retryWrites=true&w=majority

# JWT secret for authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini API key for automated product draft suggestions
GEMINI_API_KEY=your_gemini_api_key_here
