# Server configuration
PORT=5000
NODE_ENV=development

# Allowed client origins for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000

# Supabase Cloud Database Configuration
# Lấy tại Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# JWT secret for authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini API key for automated product draft suggestions
GEMINI_API_KEY=your_gemini_api_key_here
